# =============================================================================
# Configuración Local — Variables de entorno
# =============================================================================
# Copiar este archivo como .env en la raíz del proyecto:
#   cp infra/local/.env.example .env
# =============================================================================

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# DuckDB
DUCKDB_DATABASE=data/tourism.duckdb

# Dagster
DAGSTER_HOME=dagster/.dagster_home

# dbt
DBT_PROFILES_DIR=dbt
DBT_TARGET=local
