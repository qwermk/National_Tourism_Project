# =============================================================================
# Configuración Local — Variables de entorno
# =============================================================================
# Copiar este archivo como .env en la raíz del proyecto:
#   cp infra/local/.env.example .env
# =============================================================================

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# DuckDB
DUCKDB_DATABASE=data/tourism.duckdb

# Dagster
DAGSTER_HOME=dagster/.dagster_home

# dbt
DBT_PROFILES_DIR=dbt
DBT_TARGET=local

# ---------------------------------------------------------------------------
# Alertas — Dagster run failure notifications
# ---------------------------------------------------------------------------
# Slack: crea un Incoming Webhook en https://api.slack.com/apps
# Dejar en blanco para deshabilitar el canal.
SLACK_WEBHOOK_URL=

# Email (SMTP con STARTTLS — ej. Gmail, SendGrid, SES)
# Dejar SMTP_HOST en blanco para deshabilitar el canal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# URL base de la UI de Dagster (usada en los mensajes de alerta)
DAGSTER_UI_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Conectores a fuentes reales — Task 9
# ---------------------------------------------------------------------------
# World Bank API: sin autenticación, siempre activo.
# Override opcional de la URL base (raramente necesario):
# WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# CITUR — datos.gov.co
# Pasos para obtener las URLs:
#   1. Ir a https://www.datos.gov.co
#   2. Buscar el dataset deseado (ej. "Viajeros no residentes llegadas")
#   3. Hacer clic en "Exportar" → "CSV"
#   4. Copiar la URL de descarga y pegarla aquí
#
# Formato esperado:
#   https://www.datos.gov.co/api/views/{ID_DATASET}/rows.csv?accessType=DOWNLOAD
#
# Dejar en blanco para usar datos sintéticos como fallback.
CITUR_ARRIVALS_URL=
CITUR_OCCUPANCY_URL=

# HTTP Resource — reintentos y timeout (valores por defecto mostrados)
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=3
# HTTP_RETRY_DELAY=2.0
